# 统一使用 LF，避免 Windows 检出时把 shell 脚本改成 CRLF 导致容器启动失败
* text=auto eol=lf

# 明确指定二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary

# shell 脚本必须 LF（否则 alpine 里 /bin/sh 会报 "not found"）
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
